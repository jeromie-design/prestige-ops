# Caddy reverse proxy for the Prestige ops stack.
# Two public subdomains terminate here; everything else stays on the internal network.

ops.prestigeaccessories.net {
    encode zstd gzip

    # Bridge webhook endpoint, exposed publicly only because Strapi 5's webhook
    # URL validator rejects internal Docker hostnames. The bridge itself validates
    # x-bridge-secret on every request, so unauthorized callers get a 401.
    handle_path /bridge/* {
        reverse_proxy bridge:4000
    }

    reverse_proxy strapi:1337
}

social.prestigeaccessories.net {
    encode zstd gzip
    # Postiz frontend (Next.js) listens on 4200 inside the container.
    # It internally proxies /api to the NestJS backend on :3000, so Caddy
    # should ONLY talk to the frontend port; do not split routes here.
    reverse_proxy postiz:4200
}
