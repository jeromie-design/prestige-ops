{
  "kind": "collectionType",
  "collectionName": "drops",
  "info": {
    "singularName": "drop",
    "pluralName": "drops",
    "displayName": "Drop",
    "description": "A product drop, image, name, price, social copy. Drives /products tiles on prestigeaccessories.net and Postiz social publish."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Belts",
        "Shoes",
        "Jackets",
        "Accessories"
      ]
    },
    "price": {
      "type": "string"
    },
    "tag": {
      "type": "enumeration",
      "enum": [
        "New",
        "Limited"
      ]
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "socialCopy": {
      "type": "text"
    },
    "captionInstagram": {
      "type": "text"
    },
    "captionTikTok": {
      "type": "text"
    },
    "captionPinterest": {
      "type": "text"
    },
    "captionThreads": {
      "type": "text"
    },
    "captionYoutubeTitle": {
      "type": "string"
    },
    "captionYoutubeDescription": {
      "type": "text"
    },
    "captionMarketplace": {
      "type": "text"
    },
    "captionFacebookGroup": {
      "type": "text"
    },
    "captionWhatnot": {
      "type": "text"
    },
    "ebayTitle": {
      "type": "string"
    },
    "ebayDescription": {
      "type": "text"
    },
    "condition": {
      "type": "enumeration",
      "enum": [
        "New",
        "New with tags",
        "Pre-Owned",
        "Refurbished",
        "For parts"
      ]
    },
    "ebaySize": {
      "type": "string"
    },
    "ebayColor": {
      "type": "string"
    },
    "ebayMaterial": {
      "type": "string"
    },
    "ebayItemLocationZip": {
      "type": "string"
    },
    "ebayShippingPolicyId": {
      "type": "string"
    },
    "ebayReturnPolicyId": {
      "type": "string"
    },
    "ebayPaymentPolicyId": {
      "type": "string"
    },
    "ebayCategoryId": {
      "type": "string"
    },
    "ebayInventoryQuantity": {
      "type": "integer",
      "default": 1
    },
    "ebayListingState": {
      "type": "enumeration",
      "enum": [
        "draft",
        "live",
        "sold",
        "withdrawn"
      ],
      "default": "draft"
    },
    "ebayListingId": {
      "type": "string"
    },
    "channels": {
      "type": "json"
    },
    "scheduledAt": {
      "type": "datetime"
    },
    "featured": {
      "type": "boolean",
      "default": true
    }
  }
}
