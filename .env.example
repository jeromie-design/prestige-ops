# Prestige Ops, environment template
# Copy to .env on the EC2 box. Do NOT commit the populated .env.
# Generate secrets with: openssl rand -hex 32

# ----- Public URLs (DNS must point both subdomains at this box) -----
STRAPI_PUBLIC_URL=https://ops.prestigeaccessories.net
POSTIZ_PUBLIC_URL=https://social.prestigeaccessories.net

# ----- Postgres (shared, two databases created on first boot) -----
POSTGRES_USER=prestige
POSTGRES_PASSWORD=replace-with-strong-password

# ----- Strapi secrets (generate each with: openssl rand -hex 32) -----
STRAPI_APP_KEYS=key1,key2,key3,key4
STRAPI_API_TOKEN_SALT=
STRAPI_ADMIN_JWT_SECRET=
STRAPI_TRANSFER_TOKEN_SALT=
STRAPI_JWT_SECRET=

# Strapi API token issued from Strapi admin UI after first boot.
# Bridge service uses this to read Drop entries.
STRAPI_API_TOKEN=

# ----- Postiz secrets -----
POSTIZ_JWT_SECRET=
# API key created in Postiz admin UI after first boot.
# Bridge service uses this to schedule social posts.
POSTIZ_API_KEY=

# ----- Bridge -----
# Shared secret Strapi includes as a header when calling the bridge webhook.
# Set the same value in Strapi's webhook config.
BRIDGE_WEBHOOK_SECRET=

# Site rebuild trigger.
# prestige-site is a Cloudflare Workers project deployed from jeromie-design/prestige-site
# on every push to main. To trigger a rebuild, the bridge touches a marker file via the
# GitHub API; Cloudflare auto-deploys the resulting commit.
#
# Generate a fine-grained PAT scoped to ONLY jeromie-design/prestige-site with
# "Contents: Read and write" permission, then paste it here.
GITHUB_DEPLOY_TOKEN=
GITHUB_DEPLOY_REPO=jeromie-design/prestige-site
GITHUB_DEPLOY_BRANCH=main
GITHUB_DEPLOY_MARKER_PATH=.cloudflare/last-drop.txt

# Alternative: Cloudflare Pages deploy hook URL.
# Leave blank when GITHUB_DEPLOY_TOKEN is set above. Only used if prestige-site
# migrates from Workers to Pages, which has native deploy-hook URLs.
CLOUDFLARE_DEPLOY_HOOK_URL=

# ----- Bridge write-back token (Strapi -> Strapi) -----
# Bridge uses this to PATCH Drop entries when filling AI-generated socialCopy.
# Create in Strapi admin: Settings -> API Tokens -> + Create new API Token
#   Type:        Custom
#   Name:        bridge
#   Duration:    Unlimited
#   Permissions: Drop -> tick find AND update
STRAPI_BRIDGE_TOKEN=

# ----- Anthropic / Claude -----
# Powers AI-generated socialCopy. Get from console.anthropic.com.
# Falls back to no-op if blank, bridge will still ferry publish events.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
