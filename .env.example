# Prestige Ops, environment template
# Copy to .env on the EC2 box. Do NOT commit the populated .env.
# Generate secrets with: openssl rand -hex 32

# ----- Public URLs (DNS must point both subdomains at this box) -----
STRAPI_PUBLIC_URL=https://ops.prestigeaccessories.net
POSTIZ_PUBLIC_URL=https://social.prestigeaccessories.net

# ----- Postgres (shared, two databases created on first boot) -----
POSTGRES_USER=prestige
POSTGRES_PASSWORD=replace-with-strong-password

# ----- Strapi secrets (generate each with: openssl rand -hex 32) -----
STRAPI_APP_KEYS=key1,key2,key3,key4
STRAPI_API_TOKEN_SALT=
STRAPI_ADMIN_JWT_SECRET=
STRAPI_TRANSFER_TOKEN_SALT=
STRAPI_JWT_SECRET=

# Strapi API token issued from Strapi admin UI after first boot.
# Bridge service uses this to read Drop entries.
STRAPI_API_TOKEN=

# ----- Postiz secrets -----
POSTIZ_JWT_SECRET=
# API key created in Postiz admin UI after first boot.
# Bridge service uses this to schedule social posts.
POSTIZ_API_KEY=

# ----- Bridge -----
# Shared secret Strapi includes as a header when calling the bridge webhook.
# Set the same value in Strapi's webhook config.
BRIDGE_WEBHOOK_SECRET=

# Site rebuild trigger.
# prestige-site is a Cloudflare Workers project deployed from jeromie-design/prestige-site
# on every push to main. To trigger a rebuild, the bridge touches a marker file via the
# GitHub API; Cloudflare auto-deploys the resulting commit.
#
# Generate a fine-grained PAT scoped to ONLY jeromie-design/prestige-site with
# "Contents: Read and write" permission, then paste it here.
GITHUB_DEPLOY_TOKEN=
GITHUB_DEPLOY_REPO=jeromie-design/prestige-site
GITHUB_DEPLOY_BRANCH=main
GITHUB_DEPLOY_MARKER_PATH=.cloudflare/last-drop.txt

# Alternative: Cloudflare Pages deploy hook URL.
# Leave blank when GITHUB_DEPLOY_TOKEN is set above. Only used if prestige-site
# migrates from Workers to Pages, which has native deploy-hook URLs.
CLOUDFLARE_DEPLOY_HOOK_URL=

# ----- Bridge write-back token (Strapi -> Strapi) -----
# Bridge uses this to PATCH Drop entries when filling AI-generated socialCopy.
# Create in Strapi admin: Settings -> API Tokens -> + Create new API Token
#   Type:        Custom
#   Name:        bridge
#   Duration:    Unlimited
#   Permissions: Drop -> tick find AND update
STRAPI_BRIDGE_TOKEN=

# ----- Anthropic / Claude -----
# Powers AI-generated socialCopy. Get from console.anthropic.com.
# Falls back to no-op if blank, bridge will still ferry publish events.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ----- Postiz: social platform OAuth credentials -----
# Each dev app is registered ONCE on the platform's developer console.
# Redirect URIs to register inside each dev console:
#   Pinterest         -> https://social.prestigeaccessories.net/integrations/social/pinterest
#   Instagram (standalone, new IG Login) -> https://social.prestigeaccessories.net/integrations/social/instagram-standalone
#   Instagram (via FB Business)          -> https://social.prestigeaccessories.net/integrations/social/instagram
#   Facebook Page     -> https://social.prestigeaccessories.net/integrations/social/facebook
#   Threads           -> https://social.prestigeaccessories.net/integrations/social/threads
#   TikTok            -> https://social.prestigeaccessories.net/integrations/social/tiktok
#   YouTube           -> https://social.prestigeaccessories.net/integrations/social/youtube
#
# Pinterest dev app: https://developers.pinterest.com/apps/1580081/ (App ID 1580081, secret gated by trial review).
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Meta dev app (developers.facebook.com) — one app unlocks IG Standalone + IG via FB + FB Page + Threads.
# Postiz reads the FACEBOOK_* pair for FB Page + IG via FB, INSTAGRAM_* for IG Standalone, THREADS_* for Threads.
# Typically the same App ID / Secret pair is reused for all three since they live in the same Meta dev app;
# Postiz just looks up different env vars depending on which channel was clicked.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=

# TikTok dev app (developers.tiktok.com). Deferred until video workflow exists.
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# YouTube via Google Cloud OAuth (console.cloud.google.com). Deferred until video workflow exists.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ----- eBay Sell API -----
# Full design + auth flow lives in docs/EBAY-INTEGRATION.md.
#
# EBAY_ENV switches the bridge between Sandbox and Production:
#   sandbox    -> https://api.sandbox.ebay.com  (free, no real listings, use Sandbox seller account)
#   production -> https://api.ebay.com          (real listings, real money, needs Production review)
#
# App credentials come from developer.ebay.com -> My Account -> Application Keysets.
# Each environment (Sandbox, Production) has its own keyset, swap the values when
# flipping EBAY_ENV. Dev ID is shared across both.
EBAY_ENV=sandbox
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=

# User token + refresh token come from the OAuth2 user-consent flow run once by Tyler.
# See docs/EBAY-INTEGRATION.md "Auth flow" section. EBAY_USER_TOKEN is the short-lived
# (2 hour) access token cached in memory by the bridge, EBAY_REFRESH_TOKEN is the long-lived
# (18 month) credential the bridge uses to mint fresh access tokens.
EBAY_USER_TOKEN=
EBAY_REFRESH_TOKEN=

# Business policy IDs from seller hub -> Business policies. Create one of each, paste IDs here.
# Per-Drop overrides on the Drop schema (ebayShippingPolicyId etc.) take precedence when set.
EBAY_DEFAULT_SHIPPING_POLICY_ID=
EBAY_DEFAULT_RETURN_POLICY_ID=
EBAY_DEFAULT_PAYMENT_POLICY_ID=

# Default ship-from ZIP for the merchant location. Per-Drop override via ebayItemLocationZip.
EBAY_DEFAULT_LOCATION_ZIP=

# Default eBay leaf category. 2993 = Men's Belts (current Prestige inventory mix).
# Per-Drop override via ebayCategoryId once shoes / jackets / accessories are listed.
EBAY_DEFAULT_CATEGORY_ID=2993
